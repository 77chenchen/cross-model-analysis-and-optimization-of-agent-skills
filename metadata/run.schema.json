{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formal benchmark run metadata",
  "type": "object",
  "required": ["run_id", "timestamp", "model_provider", "requested_model_id", "task_id", "task_hash", "split", "skill_id", "skill_version", "skill_hash", "context_limit", "max_steps", "timeout_minutes", "tool_schema_version", "verifier_hash", "harness_git_commit"],
  "properties": {
    "run_id": {"type": "string"},
    "runner": {"type": "string"},
    "runner_version": {"type": "string"},
    "timestamp": {"type": "string"},
    "model_provider": {"type": "string"},
    "requested_model_id": {"type": "string"},
    "returned_model_id": {"type": ["string", "null"]},
    "model_snapshot": {"type": ["string", "null"]},
    "temperature": {"type": ["number", "null"]},
    "temperature_requested": {"type": ["number", "null"]},
    "temperature_effective": {"type": ["number", "null"]},
    "sampling_control": {"enum": ["supported", "unsupported_by_cli", "unknown"]},
    "sampling_parameter_echo": {"type": ["object", "null"]},
    "seed_requested": {"type": ["integer", "null"]},
    "seed_effective": {"type": ["integer", "null"]},
    "seed": {"type": ["integer", "null"]},
    "context_limit": {"type": "integer"},
    "max_steps": {"type": "integer"},
    "timeout_minutes": {"type": "integer"},
    "reasoning_setting": {"type": ["string", "null"]},
    "max_output_tokens": {"type": ["integer", "null"]},
    "task_id": {"type": "string"},
    "task_hash": {"type": "string"},
    "split": {"enum": ["pilot", "dev", "test_in", "test_out"]},
    "skill_id": {"enum": ["A", "B", "C"]},
    "skill_version": {"type": "string"},
    "skill_hash": {"type": "string"},
    "tool_schema_version": {"type": "integer"},
    "verifier_hash": {"type": "string"},
    "harness_git_commit": {"type": "string"},
    "container_image": {"type": ["string", "null"]}
    ,"outcome_category": {"enum": ["empty_termination", "max_steps_reached", "compile_error", "verifier_fail", "timeout", "context_overflow", "provider_error", "pass"]}
    ,"legacy_outcome_category": {"enum": ["empty_termination", "max_steps_reached", "compile_error", "verifier_fail", "timeout", "context_overflow", "provider_error", "pass"]}
    ,"outcome_flags": {"type": "object", "properties": {"final_empty": {"type": "boolean"}, "no_edit": {"type": "boolean"}, "compile_error": {"type": "boolean"}, "verifier_fail": {"type": "boolean"}, "timeout": {"type": "boolean"}, "context_overflow": {"type": "boolean"}, "provider_error": {"type": "boolean"}, "max_steps_reached": {"type": "boolean"}}, "required": ["final_empty", "no_edit", "compile_error", "verifier_fail", "timeout", "context_overflow", "provider_error"], "additionalProperties": false}
    ,"partial_score": {"type": ["number", "null"]}
    ,"verifier_check_count": {"type": "integer"}
    ,"verifier_checks_passed": {"type": "integer"}
    ,"finish_reason": {"type": ["string", "null"]}
    ,"finish_reason_available": {"type": "boolean"}
    ,"process_timed_out": {"type": "boolean"}
    ,"run_cohort": {"type": "string"}
    ,"repetition": {"type": ["integer", "null"], "minimum": 1}
    ,"r2_response_count": {"type": "integer", "minimum": 0}
    ,"r2_tool_call_count": {"type": "integer", "minimum": 0}
    ,"r2_tool_parse": {"type": "object"}
    ,"r2_usage": {"type": "object"}
    ,"r2_process_returncode": {"type": "integer"}
    ,"request_retry_events": {"type": "array"}
    ,"request_retry_count": {"type": "integer", "minimum": 0}
    ,"l3b_trigger_at": {"type": ["integer", "null"]}
    ,"l3b_triggered": {"type": "boolean"}
    ,"worker_concurrency": {"type": "integer", "minimum": 1}
    ,"replacement_of": {"type": ["string", "null"]}
  }
}
